DATABASE_URL=postgresql://aiworkspace:change-me@localhost:5432/aiworkspace
DIRECT_DATABASE_URL=postgresql://aiworkspace:change-me@localhost:5432/aiworkspace
REDIS_URL=redis://localhost:6379

# Required and distinct in production.
JWT_ACCESS_SECRET=replace-with-a-distinct-32-character-access-secret
JWT_REFRESH_SECRET=replace-with-a-distinct-32-character-refresh-secret
JWT_ISSUER=aiworkspace-api
JWT_ACCESS_AUDIENCE=aiworkspace-api
JWT_REFRESH_AUDIENCE=aiworkspace-auth
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
