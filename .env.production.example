# AIWorkspace production Docker Compose environment
# Copy this file to .env.production and replace every placeholder.
#
# Database and Redis passwords are interpolated into connection URLs.
# Prefer URL-safe characters: letters, numbers, hyphen, underscore, period, and tilde.

# PostgreSQL
DB_USER=aiworkspace
DB_PASSWORD=replace-with-a-strong-url-safe-database-password
DB_NAME=aiworkspace_prod

# Redis
REDIS_PASSWORD=replace-with-a-strong-url-safe-redis-password

# Authentication
# Both secrets must be at least 32 characters and must be different.
JWT_ACCESS_SECRET=replace-with-a-distinct-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-distinct-refresh-secret-at-least-32-characters
JWT_ISSUER=aiworkspace-api
JWT_ACCESS_AUDIENCE=aiworkspace-api
JWT_REFRESH_AUDIENCE=aiworkspace-auth

# Public web origin
# Use HTTPS for non-loopback production deployments.
FRONTEND_URL=https://app.example.com

# Published host ports
API_PORT=4000
WEB_PORT=80
