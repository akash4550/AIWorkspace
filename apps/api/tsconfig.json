{
  "compilerOptions": {
    "target": "ES2022",

    "module": "commonjs",
    "moduleResolution": "node",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "types": [
      "node",
      "jest"
    ]
  },

  "include": [
    "src/**/*"
  ],

  "exclude": [
    "dist",
    "node_modules",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/__tests__/**/*"
  ]
}
